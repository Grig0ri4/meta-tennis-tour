        function getPlayerBadge(p) {
            if (!p) return '';
            if (p.seedNum) return `<span class="badge badge-seed">(${p.seedNum})</span>`;
            if (p.entryTag === 'Q') return `<span class="badge badge-q">[Q]</span>`;
