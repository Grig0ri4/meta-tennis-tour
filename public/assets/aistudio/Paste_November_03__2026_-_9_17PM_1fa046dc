        // --- 3. ИНИЦИАЛИЗАЦИЯ И МИГРАЦИЯ ---
        function initData() {
            if (!tournaments) {
                let savedOldTourneys = JSON.parse(localStorage.getItem('meta_tournaments_v6')) || [];
                tournaments = FULL_CALENDAR_TEMPLATE.map(t => {
                    let old = savedOldTourneys.find(o => o.id === t.id);
                    if (old) return { ...t, name: old.name, surface: old.surface };
                    return t;
                });
                saveTournaments();
            }

            if (players.length < 140) {
                players = [...PRESERVED_BASE];
            }

            // Очистка имен 141-300 от цифр
            let poolIndex = 0;
            let existingNames = new Set(players.slice(0, 140).map(p => p.name.toLowerCase()));

            for (let i = 140; i < players.length; i++) {
                let p = players[i];
                if (/\s+\d+$/.test(p.name) || existingNames.has(p.name.toLowerCase())) {
                    while (poolIndex < CLEAN_UNIQUE_POOL.length && existingNames.has(CLEAN_UNIQUE_POOL[poolIndex].name.toLowerCase())) {
                        poolIndex++;
                    }
                    if (poolIndex < CLEAN_UNIQUE_POOL.length) {
                        const cleanEntry = CLEAN_UNIQUE_POOL[poolIndex];
                        p.name = cleanEntry.name;
                        if (cleanEntry.flag) p.flag = cleanEntry.flag;
                        if (cleanEntry.b) p.birthDate = cleanEntry.b;
                        poolIndex++;
                    }
                }
                existingNames.add(p.name.toLowerCase());
            }

            let currentPts = (players[players.length - 1] ? players[players.length - 1].points : 100) - 1;
            while (players.length < 300) {
                let cleanEntry = CLEAN_UNIQUE_POOL[poolIndex % CLEAN_UNIQUE_POOL.length];
                let fullName = cleanEntry ? cleanEntry.name : `Tennis Player ${players.length + 1}`;
                let flag = cleanEntry ? cleanEntry.flag : "ESP";
                let bDate = cleanEntry ? cleanEntry.b : "1998-05-15";
                poolIndex++;

                players.push({
                    id: 'p_' + (players.length + 1),
                    rank: players.length + 1,
                    name: fullName,
                    flag: flag,
                    points: Math.max(15, currentPts),
                    racePoints: 0,
                    birthDate: bDate,
                    tournamentPoints: {},
                    rankChange: 0
                });
                currentPts = Math.max(15, currentPts - 1);
            }

            players.forEach(p => {
                if (!p.tournamentPoints) p.tournamentPoints = {};
                if (p.rankChange === undefined) p.rankChange = 0;
                if (p.racePoints === undefined) p.racePoints = 0;
            });

            backfill2023HistoryFromDraws();

            // АВТО-ИСПРАВЛЕНИЕ ЗАДВОЕННЫХ ОЧКОВ ПРИ СБОЕ
            if (!localStorage.getItem('meta_repair_applied_v3')) {
                repairOvercountedPoints();
                localStorage.setItem('meta_repair_applied_v3', 'true');
            }

            savePlayers();
        }

        function backfill2023HistoryFromDraws() {
            const p128 = [10, 50, 100, 200, 400, 800, 1300, 2000];
            const p64 = [10, 50, 100, 200, 400, 650, 1000];
            const p32 = [0, 50, 100, 200, 330, 500];

            tournaments.forEach(t => {
                const drawData = JSON.parse(localStorage.getItem(`draw_${t.id}_2023`));
                if (drawData && drawData.length > 0) {
                    const ptsMap = (t.size === 128) ? p128 : (t.size === 64 ? p64 : p32);

                    if (t.id === 'finals') {
                        if (drawData[0] && drawData[1]) {
                            const gA = calculateGroupStandings(drawData[0]);
                            const gB = calculateGroupStandings(drawData[1]);
                            [...gA, ...gB].forEach(st => {
                                recordPoints(st.player.id, t.id, 2023, st.wins * 200);
                            });
                        }
                        const finalM = drawData[drawData.length - 1][0];
                        if (finalM && finalM.winner) {
                            const winId = finalM.winner.id;
                            const losId = (finalM.p1.id === winId) ? finalM.p2.id : finalM.p1.id;
                            recordPoints(winId, t.id, 2023, (getDefendingPoints({ tournamentPoints: players.find(p=>p.id===winId)?.tournamentPoints }, t.id, 2024) || 0) + 900);
                            recordPoints(losId, t.id, 2023, (getDefendingPoints({ tournamentPoints: players.find(p=>p.id===losId)?.tournamentPoints }, t.id, 2024) || 0) + 400);
                        }
                    } else {
                        drawData.forEach((round, rIdx) => {
                            round.forEach(m => {
                                if (m && m.winner) {
                                    const loserId = (m.p1 && m.winner.id === m.p1.id) ? (m.p2 ? m.p2.id : null) : (m.p1 ? m.p1.id : null);
                                    if (loserId) recordPoints(loserId, t.id, 2023, ptsMap[rIdx]);
                                }
                            });
                        });
                        const finalM = drawData[drawData.length - 1][0];
                        if (finalM && finalM.winner) {
                            recordPoints(finalM.winner.id, t.id, 2023, ptsMap[ptsMap.length - 1]);
                        }
                    }
                }
            });
        }

        function recordPoints(playerId, tourneyId, year, pts) {
            const p = players.find(x => x.id === playerId);
            if (p) {
                if (!p.tournamentPoints) p.tournamentPoints = {};
                if (!p.tournamentPoints[tourneyId]) p.tournamentPoints[tourneyId] = {};
                p.tournamentPoints[tourneyId][year] = pts;
            }
        }

        // --- ВОССТАНОВЛЕНИЕ ОЧКОВ ПРИ СБОЕ И МНОГОКРАТНЫХ КЛИКАХ ---
        function repairOvercountedPoints() {
            const pts128 = [10, 50, 100, 200, 400, 800, 1300, 2000];
            const pts64 = [10, 50, 100, 200, 400, 650, 1000];
            const pts32 = [0, 50, 100, 200, 330, 500];

            let exact2024Earned = {};
            players.forEach(p => { exact2024Earned[p.id] = 0; });

            tournaments.forEach(t => {
                const draw2024 = JSON.parse(localStorage.getItem(`draw_${t.id}_2024`));
                if (draw2024 && draw2024.length > 0) {
                    const finalM = draw2024[draw2024.length - 1][0];
                    if (finalM && finalM.winner) {
                        const scale = (t.size === 128) ? pts128 : (t.size === 64 ? pts64 : pts32);
                        draw2024.forEach((round, rIdx) => {
                            round.forEach(m => {
                                if (m && m.winner) {
                                    const loserId = (m.p1 && m.winner.id === m.p1.id) ? (m.p2 ? m.p2.id : null) : (m.p1 ? m.p1.id : null);
                                    if (loserId) exact2024Earned[loserId] = (exact2024Earned[loserId] || 0) + scale[rIdx];
                                }
                            });
                        });
                        exact2024Earned[finalM.winner.id] = (exact2024Earned[finalM.winner.id] || 0) + scale[scale.length - 1];
                    }
                }
            });

            const end2023Data = seasonsHistory['2023']?.yearEndTop50 || seasonsHistory['2023']?.top10 || [];
            const base2023Map = {};
            end2023Data.forEach(p => { base2023Map[p.id] = p.points; });

            players.forEach(p => {
                const earned = exact2024Earned[p.id] || 0;
                p.racePoints = earned;

                if (base2023Map[p.id]) {
                    let defTotal = 0;
                    tournaments.forEach(t => {
                        const draw2024 = JSON.parse(localStorage.getItem(`draw_${t.id}_2024`));
                        if (draw2024 && draw2024[draw2024.length - 1][0]?.winner) {
                            defTotal += (p.tournamentPoints?.[t.id]?.[2023] || 0);
                        }
                    });
                    p.points = Math.max(15, base2023Map[p.id] - defTotal + earned);
                }
            });

            savePlayers();
        }

