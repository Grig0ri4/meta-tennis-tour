        // ГЕНЕРАТОР РЕАЛИСТИЧНОГО ТЕННИСНОГО СЧЕТА
        function generateRealisticTennisSet(p1Wins, isDecidingSetTB = false, rankDiff = 0) {
            const roll = Math.random();
            let score = "";

            if (p1Wins) {
                if (roll < 0.04 || (rankDiff > 50 && roll < 0.12)) score = "6-0";
                else if (roll < 0.14 || (rankDiff > 40 && roll < 0.25)) score = "6-1";
                else if (roll < 0.35) score = "6-2";
                else if (roll < 0.60) score = "6-3";
                else if (roll < 0.80) score = "6-4";
                else if (roll < 0.90) score = "7-5";
                else {
                    const loserPoints = isDecidingSetTB ? (Math.random() < 0.5 ? 7 + Math.floor(Math.random() * 2) : 5) : (3 + Math.floor(Math.random() * 3));
                    score = `7-6(${loserPoints})`;
                }
            } else {
                if (roll < 0.04 || (rankDiff < -50 && roll < 0.12)) score = "0-6";
                else if (roll < 0.14 || (rankDiff < -40 && roll < 0.25)) score = "1-6";
                else if (roll < 0.35) score = "2-6";
                else if (roll < 0.60) score = "3-6";
                else if (roll < 0.80) score = "4-6";
                else if (roll < 0.90) score = "5-7";
                else {
                    const loserPoints = isDecidingSetTB ? (Math.random() < 0.5 ? 7 + Math.floor(Math.random() * 2) : 5) : (3 + Math.floor(Math.random() * 3));
                    score = `6-7(${loserPoints})`;
                }
            }
            return score;
        }

        function computeSimMatchScores(m, forcedWinnerNumber = 0) {
            const req = (activeTourney && activeTourney.bestOf === 5) ? 3 : 2;
            let p1W = 0, p2W = 0, scores = [];

            const r1 = (m.p1 && m.p1.rank) ? m.p1.rank : 100;
            const r2 = (m.p2 && m.p2.rank) ? m.p2.rank : 100;
            const rankDiff = r2 - r1;

            let p1Chance = r2 / (r1 + r2);
            if (isNaN(p1Chance)) p1Chance = 0.5;
            if (forcedWinnerNumber === 1) p1Chance = 1.0;
            if (forcedWinnerNumber === 2) p1Chance = 0.0;

            while (p1W < req && p2W < req) {
                const isFinalSetTB = (req === 3 && (p1W + p2W === 4));
                const p1Takes = Math.random() < p1Chance;
                const setStr = generateRealisticTennisSet(p1Takes, isFinalSetTB, rankDiff);
                scores.push(setStr);

                if (p1Takes) p1W++;
                else p2W++;
            }

            return { winner: p1W > p2W ? m.p1 : m.p2, scores: scores };
        }

        // 1. ГЕНЕРИРУЕТ СЧЕТ В ПОЛЕ ВВОДА (ИГРОК ВИДИТ СЧЕТ ПЕРЕД СОХРАНЕНИЕМ)
        function generateRandomScoreToInput() {
            if (!activeMatchScore || !activeMatchScore.match) return;
            const sim = computeSimMatchScores(activeMatchScore.match);
            document.getElementById('quickScoreStr').value = sim.scores.join(' ');
        }

        // 2. БЫСТРЫЙ РАСЧЕТ И МГНОВЕННОЕ ПРИМЕНЕНИЕ
        function instantSimulateMatch() {
            if (!activeMatchScore || !activeMatchScore.match) return;
            const sim = computeSimMatchScores(activeMatchScore.match);
            applyMatchWinner(activeMatchScore.rIdx, activeMatchScore.mIdx, sim.winner, sim.scores);
            closeModal('scoreModal');
        }

        function quickApplyWinner(winnerId) {
            const isP1 = activeMatchScore.match.p1.id === winnerId;
            const sim = computeSimMatchScores(activeMatchScore.match, isP1 ? 1 : 2);
            applyMatchWinner(activeMatchScore.rIdx, activeMatchScore.mIdx, sim.winner, sim.scores);
            closeModal('scoreModal');
        }

        function saveQuickStringScore() {
            if (!activeMatchScore) return;
            const str = document.getElementById('quickScoreStr').value.trim();
            if (!str) return alert("Введите счет матча!");

            const sets = str.split(/\s+/);
            const req = (activeTourney && activeTourney.bestOf === 5) ? 3 : 2;
            let p1W = 0, p2W = 0;

            sets.forEach(s => {
                const clean = s.replace(/\(\d+\)/, '');
                const parts = clean.split('-');
                if (parts.length === 2) {
                    const g1 = parseInt(parts[0]);
                    const g2 = parseInt(parts[1]);
                    if (g1 > g2) p1W++;
                    else if (g2 > g1) p2W++;
                }
            });

            if (p1W < req && p2W < req) return alert(`Недостаточно выигранных сетов! Для победы требуется ${req} выигранных сета.`);

            const winner = p1W > p2W ? activeMatchScore.match.p1 : activeMatchScore.match.p2;
            applyMatchWinner(activeMatchScore.rIdx, activeMatchScore.mIdx, winner, sets);
            closeModal('scoreModal');
        }

        function applyMatchWinner(rIdx, mIdx, winner, scoreArr) {
            const match = currentDraw[rIdx][mIdx];
            match.winner = winner;
            match.score = scoreArr;

            if (activeTourney.id === 'finals') {
                const isGroupAComplete = currentDraw[0].every(m => m.winner);
                const isGroupBComplete = currentDraw[1].every(m => m.winner);
                if (isGroupAComplete && isGroupBComplete) {
                    const groupAStats = calculateGroupStandings(currentDraw[0]);
                    const groupBStats = calculateGroupStandings(currentDraw[1]);
                    if (groupAStats.length >= 2 && groupBStats.length >= 2) {
                        currentDraw[2][0].p1 = groupAStats[0].player;
                        currentDraw[2][0].p2 = groupBStats[1].player;
                        currentDraw[2][1].p1 = groupBStats[0].player;
                        currentDraw[2][1].p2 = groupAStats[1].player;
                    }
                }
                if (rIdx === 2) {
                    if (mIdx === 0) currentDraw[3][0].p1 = winner;
                    else currentDraw[3][0].p2 = winner;
                }
            } else {
                if (rIdx + 1 < currentDraw.length) {
                    const nextMIdx = Math.floor(mIdx / 2);
                    if (mIdx % 2 === 0) currentDraw[rIdx + 1][nextMIdx].p1 = winner;
                    else currentDraw[rIdx + 1][nextMIdx].p2 = winner;
                }
            }

            saveDraw();
            renderMatches();
        }

        function autoSimulateRound() {
            if (!currentDraw || currentDraw.length === 0) return;
            currentDraw[activeRoundIdx].forEach((m, idx) => {
                if (!m.winner && m.p1 && m.p2) {
                    const sim = computeSimMatchScores(m);
                    applyMatchWinner(activeRoundIdx, idx, sim.winner, sim.scores);
                }
            });
        }

        // --- 8. ФОНОВЫЙ ТУР ATP 250 (БЕЗ ОШИБОК) ---
        function runBackgroundATP250Tournaments(mainTourneyParticipants) {
            try {
                const participantIds = new Set(
                    (mainTourneyParticipants || []).filter(p => p && p.id).map(p => p.id)
                );
                const available250 = players.filter(p => p && p.id && !participantIds.has(p.id) && p.rank >= 25 && p.rank <= 260);

                if (available250.length < 32) return "";

                const tName = BG_250_NAMES[Math.floor(Math.random() * BG_250_NAMES.length)];
                const tourneyPool = shuffleArray(available250).slice(0, 32);

                const winner = tourneyPool[0];
                const finalist = tourneyPool[1];
                const sf1 = tourneyPool[2], sf2 = tourneyPool[3];
                const qf = tourneyPool.slice(4, 8);
                const r16 = tourneyPool.slice(8, 16);

                function addPts(pl, pts) {
                    if (!pl) return;
                    pl.points += pts;
                    pl.racePoints = (pl.racePoints || 0) + pts;
                    if (!pl.tournamentPoints) pl.tournamentPoints = {};
                    if (!pl.tournamentPoints[tName]) pl.tournamentPoints[tName] = {};
                    pl.tournamentPoints[tName][viewingYear] = pts;
                }

                addPts(winner, 250);
                addPts(finalist, 165);
                addPts(sf1, 100);
                addPts(sf2, 100);
                qf.forEach(p => addPts(p, 50));
                r16.forEach(p => addPts(p, 25));

                return `🎾 <b>Параллельный фоновый турнир:</b> ${tName} (ATP 250) — Чемпион: <b>${winner.name}</b> (+250 pts) | Финалист: <b>${finalist.name}</b> (+165 pts) | Полуфинал: ${sf1.name}, ${sf2.name} (+100 pts) | 1/4: (+50 pts) | 1/8: (+25 pts)`;
            } catch (err) {
                console.warn("Background 250 error avoided:", err);
                return "";
            }
        }

        // --- 9. НАЧИСЛЕНИЕ И ЗАЩИТА ОЧКОВ ПО РАУНДАМ ---
        function getDefendingPoints(player, tourneyId, year) {
            const prevYear = year - 1;
            if (player.tournamentPoints && player.tournamentPoints[tourneyId] && player.tournamentPoints[tourneyId][prevYear] !== undefined) {
                return player.tournamentPoints[tourneyId][prevYear];
            }
            return 0;
        }

        function finishTournamentAndAwardPoints() {
            if (!activeTourney) return;
            if (!currentDraw || currentDraw.length === 0) return alert("Сетка пуста!");
            const finalMatch = currentDraw[currentDraw.length - 1][0];
            if (!finalMatch || !finalMatch.winner) return alert("Финал еще не сыгран!");

            if (activeTourney.completed) {
                return alert("⚠️ Этот турнир уже завершен в текущем сезоне! Очки уже были начислены.");
            }

            // МГНОВЕННАЯ ЗАЩИТА ОТ МНОГОКРАТНЫХ КЛИКОВ
            activeTourney.completed = true;
            const btnFinish = document.getElementById('btnFinishTourney');
            if (btnFinish) {
                btnFinish.disabled = true;
                btnFinish.innerText = 'Турнир завершен ✅';
                btnFinish.style.opacity = '0.5';
                btnFinish.style.cursor = 'not-allowed';
            }

            const points128 = [10, 50, 100, 200, 400, 800, 1300, 2000];
            const points64 = [10, 50, 100, 200, 400, 650, 1000];
            const points32 = [0, 50, 100, 200, 330, 500];

            let earnedMap = {};
            let participantsList = [];

            if (activeTourney.id === 'finals') {
                const groupAStats = calculateGroupStandings(currentDraw[0]);
                const groupBStats = calculateGroupStandings(currentDraw[1]);
                [...groupAStats, ...groupBStats].forEach(st => {
                    earnedMap[st.player.id] = (st.wins * 200);
                    participantsList.push(st.player);
                });

                const sfLoser1 = (currentDraw[2][0].winner.id === currentDraw[2][0].p1.id) ? currentDraw[2][0].p2 : currentDraw[2][0].p1;
                const sfLoser2 = (currentDraw[2][1].winner.id === currentDraw[2][1].p1.id) ? currentDraw[2][1].p2 : currentDraw[2][1].p1;
                if (sfLoser1) earnedMap[sfLoser1.id] = (earnedMap[sfLoser1.id] || 0) + 400;
                if (sfLoser2) earnedMap[sfLoser2.id] = (earnedMap[sfLoser2.id] || 0) + 400;

                const finalWinner = finalMatch.winner;
                const finalRunnerUp = (finalMatch.p1.id === finalWinner.id) ? finalMatch.p2 : finalMatch.p1;
                earnedMap[finalWinner.id] = (earnedMap[finalWinner.id] || 0) + 900;
                earnedMap[finalRunnerUp.id] = (earnedMap[finalRunnerUp.id] || 0) + 400;

            } else if (activeTourney.size === 128) {
                currentDraw.forEach((round, rIdx) => {
                    round.forEach(m => {
                        if (m && m.winner && m.p1 && m.p2) {
                            const loser = (m.p1.id === m.winner.id) ? m.p2 : m.p1;
                            earnedMap[loser.id] = points128[rIdx];
                            participantsList.push(m.p1, m.p2);
                        }
                    });
                });
                earnedMap[finalMatch.winner.id] = 2000;
            } else if (activeTourney.size === 64) {
                currentDraw.forEach((round, rIdx) => {
                    round.forEach(m => {
                        if (m && m.winner && m.p1 && m.p2) {
                            const loser = (m.p1.id === m.winner.id) ? m.p2 : m.p1;
                            earnedMap[loser.id] = points64[rIdx];
                            participantsList.push(m.p1, m.p2);
                        }
                    });
                });
                earnedMap[finalMatch.winner.id] = 1000;
            } else if (activeTourney.size === 32) {
                currentDraw.forEach((round, rIdx) => {
                    round.forEach(m => {
                        if (m && m.winner && m.p1 && m.p2) {
                            const loser = (m.p1.id === m.winner.id) ? m.p2 : m.p1;
                            earnedMap[loser.id] = points32[rIdx];
                            participantsList.push(m.p1, m.p2);
                        }
                    });
                });
                earnedMap[finalMatch.winner.id] = 500;
            }

            players.forEach(p => {
                const earned = earnedMap[p.id] || 0;
                const defending = getDefendingPoints(p, activeTourney.id, viewingYear);
                const diff = earned - defending;

                p.points = Math.max(15, p.points + diff);
                p.racePoints = (p.racePoints || 0) + earned;

                if (!p.tournamentPoints) p.tournamentPoints = {};
                if (!p.tournamentPoints[activeTourney.id]) p.tournamentPoints[activeTourney.id] = {};
                p.tournamentPoints[activeTourney.id][viewingYear] = earned;
            });

            // Фоновый тур ATP 250
            let bgReport = "";
            if (activeTourney.type !== 'Итоговый') {
                bgReport = runBackgroundATP250Tournaments(participantsList);
                if (bgReport) {
                    localStorage.setItem(`bg250_${activeTourney.id}_${viewingYear}`, bgReport);
                    const bgBox = document.getElementById('bg250Notice');
                    if (bgBox) {
                        bgBox.style.display = 'block';
                        bgBox.innerHTML = bgReport;
                    }
                }
            }

            activeTourney.lastWinner = { ...finalMatch.winner };
            activeTourney.lastRunnerUp = finalMatch.p1.id === finalMatch.winner.id ? { ...finalMatch.p2 } : { ...finalMatch.p1 };
            activeTourney.lastScore = finalMatch.score ? finalMatch.score.join(' ') : 'W/O';

            saveTournaments();
            savePlayers();

            if (activeTourney.type === 'ТБШ') {
                if (!seasonsHistory[viewingYear]) seasonsHistory[viewingYear] = { year: viewingYear, slamSnapshots: {}, tournamentsData: [] };
                if (!seasonsHistory[viewingYear].slamSnapshots) seasonsHistory[viewingYear].slamSnapshots = {};

                seasonsHistory[viewingYear].slamSnapshots[activeTourney.id] = {
                    tourneyName: activeTourney.name,
                    date: currentTourDateStr,
                    top50: players.slice(0, 50).map(p => ({
                        rank: p.rank,
                        name: p.name,
                        flag: p.flag,
                        points: p.points,
                        age: calculateAge(p.birthDate)
                    }))
                };
                saveHistory();
            }

            const currentIndex = tournaments.findIndex(t => t.id === activeTourney.id);
            if (currentIndex < tournaments.length - 1) {
                const nextTourney = tournaments[currentIndex + 1];
                const nextStartMonth = String(nextTourney.startMonth + 1).padStart(2, '0');
                const nextStartDay = String(nextTourney.startDay).padStart(2, '0');
                currentTourDateStr = `${currentTourYear}-${nextStartMonth}-${nextStartDay}`;
            } else {
                currentTourDateStr = `${currentTourYear}-11-25`;
            }

            saveDate();
            initUI();
            renderPlayersTable();
            renderRaceTable();

            alert(`🎉 Турнир ${activeTourney.name} успешно завершен!\nЧемпион: ${finalMatch.winner.name}\n\nРейтинг и Чемпионская Гонка обновлены!${bgReport ? '\n\n' + bgReport.replace(/<[^>]*>/g, '') : ''}`);
        }

        // --- 10. ЗАВЕРШЕНИЕ СЕЗОНА ---
        function endSeasonAndDecayPoints() {
            if (!confirm(`Завершить сезон ${currentTourYear} и перейти в ${currentTourYear + 1} год?`)) return;

            if (!seasonsHistory[currentTourYear]) seasonsHistory[currentTourYear] = { year: currentTourYear, slamSnapshots: {}, tournamentsData: [] };

            seasonsHistory[currentTourYear].year = currentTourYear;
            seasonsHistory[currentTourYear].worldNumberOne = { ...players[0] };
            seasonsHistory[currentTourYear].yearEndTop50 = players.slice(0, 50).map(p => ({ ...p, age: calculateAge(p.birthDate) }));
            seasonsHistory[currentTourYear].tournamentsData = tournaments.map(t => ({
                id: t.id,
                name: t.name,
                type: t.type,
                surface: t.surface,
                winner: t.lastWinner || null,
                runnerUp: t.lastRunnerUp || null,
                score: t.lastScore || '—'
            }));
            saveHistory();

            currentTourYear++;
            viewingYear = currentTourYear;
            currentTourDateStr = `${currentTourYear}-01-02`;
            activeTourney = tournaments[0];
            activeTourneyId = activeTourney.id;

            players.forEach(p => { p.racePoints = 0; });

            tournaments.forEach(t => {
                t.completed = false;
                t.lastWinner = null;
                t.lastRunnerUp = null;
                t.lastScore = null;
            });

            savePlayers();
            saveTournaments();
            saveDate();
            initUI();
            renderPlayersTable();
            renderRaceTable();

            alert(`🎆 Сезон ${currentTourYear - 1} успешно занесен в Архив. Добро пожаловать в сезон ${currentTourYear}!`);
        }

        // --- 11. КАЛЕНДАРЬ ---
        function renderCalendarTable() {
            const tbody = document.getElementById('calendarTableBody');
            const selectedYear = parseInt(document.getElementById('calendarYearSelect').value) || currentTourYear;

            tbody.innerHTML = tournaments.map((t, idx) => {
                const dateRange = getTourneyDateRange(t, selectedYear);
                const isCurrent = (selectedYear === currentTourYear && t.id === activeTourney.id);
                const isDone = (selectedYear < currentTourYear) || (selectedYear === currentTourYear && t.completed);

                let statusBadge = isDone 
                    ? `<span style="color: var(--primary);">Завершен ✅</span>` 
                    : (isCurrent ? `<span style="color: var(--gold); font-weight:bold;">Идет сейчас 🎾</span>` : `<span style="color: var(--text-dim);">Ожидается ⏳</span>`);

                let badgeClass = 'badge-tier-1000';
                if (t.type === 'ТБШ') badgeClass = 'badge-tier-slam';
                else if (t.type === 'ATP 500') badgeClass = 'badge-tier-500';
                else if (t.type === 'Итоговый') badgeClass = 'badge-tier-finals';

                return `
                    <tr class="${isCurrent ? 'active-tourney-row' : ''}">
                        <td><b>#${idx + 1}</b></td>
                        <td style="color: var(--accent); font-family: monospace;">${dateRange}</td>
                        <td><span class="badge ${badgeClass}">${t.type}</span></td>
                        <td><b>${t.name}</b></td>
                        <td>${t.surface}</td>
                        <td>${t.size} игр.</td>
                        <td>${statusBadge}</td>
                        <td style="display: flex; gap: 5px;">
                            <button onclick="jumpToTourney('${t.id}', ${selectedYear})">Сетка</button>
                            <button class="btn-edit" onclick="openEditTourneyModal('${t.id}')">✏️ Ред.</button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function jumpToTourney(tourneyId, year = null) {
            if (year) {
                viewingYear = year;
                document.getElementById('drawYearSelect').value = year;
            }
            document.getElementById('tourneySelect').value = tourneyId;
            loadCurrentTourney();
            switchTab('tourney');
        }

        // --- 12. РЕЙТИНГ 52 НЕДЕЛИ ---
        function renderRankChangeBadge(diff) {
            if (diff > 0) return `<span style="color: #10b981; font-size: 11px; font-weight: bold;">▲ +${diff}</span>`;
            if (diff < 0) return `<span style="color: #ef4444; font-size: 11px; font-weight: bold;">▼ ${diff}</span>`;
            return `<span style="color: var(--text-dim); font-size: 11px;">— 0</span>`;
        }

        function renderPlayersTable() {
            const tbody = document.getElementById('playersTableBody');
            const search = document.getElementById('playerSearch').value.toLowerCase();
            const filtered = players.filter(p => p.name.toLowerCase().includes(search) || p.flag.toLowerCase().includes(search));

            tbody.innerHTML = filtered.map(p => `
                <tr>
                    <td>
                        <div style="font-weight: bold; font-size: 14px;">#${p.rank}</div>
                        <div>${renderRankChangeBadge(p.rankChange || 0)}</div>
                    </td>
                    <td><b>${p.flag}</b></td>
                    <td><b>${p.name}</b></td>
                    <td style="color: var(--accent); font-weight: bold;">${calculateAge(p.birthDate)}</td>
                    <td style="color: var(--text-dim); font-size: 12px;">${p.birthDate || '—'}</td>
                    <td><b style="color: #fff;">${p.points.toLocaleString()}</b> <small style="color: var(--text-dim);">pts</small></td>
                    <td>
                        <button onclick="openEditPlayerModal('${p.id}')">✏️ Ред.</button>
                    </td>
                </tr>
            `).join('');
        }

        // --- 13. ЧЕМПИОНСКАЯ ГОНКА ---
        function renderRaceTable() {
            const tbody = document.getElementById('raceTableBody');
            const search = (document.getElementById('raceSearch') ? document.getElementById('raceSearch').value : '').toLowerCase();

            const raceSorted = [...players].sort((a, b) => (b.racePoints || 0) - (a.racePoints || 0));
            const filtered = raceSorted.filter(p => p.name.toLowerCase().includes(search) || p.flag.toLowerCase().includes(search));

            tbody.innerHTML = filtered.map((p, idx) => {
                const raceRank = idx + 1;
                let statusBadge = "";
                if (raceRank <= 8) {
                    statusBadge = `<span style="color: var(--primary); font-weight: bold; font-size: 12px;">🎾 В зоне Итогового (#${raceRank})</span>`;
                } else if (raceRank <= 10) {
                    statusBadge = `<span style="color: var(--gold); font-size: 11px;">Запасной (#${raceRank})</span>`;
                } else {
                    statusBadge = `<span style="color: var(--text-dim); font-size: 11px;">В борьбе</span>`;
                }

                return `
                    <tr style="${raceRank <= 8 ? 'background: rgba(16, 185, 129, 0.06);' : ''}">
                        <td><b>#${raceRank}</b></td>
                        <td><b>${p.flag}</b></td>
                        <td><b>${p.name}</b></td>
                        <td style="color: var(--accent);">${calculateAge(p.birthDate)}</td>
                        <td><b style="color: var(--gold); font-size: 15px;">${(p.racePoints || 0).toLocaleString()}</b> <small style="color: var(--text-dim);">pts</small></td>
                        <td>${statusBadge}</td>
                    </tr>
                `;
            }).join('');
        }

        function openEditPlayerModal(id) {
            const p = players.find(x => x.id === id);
            if (!p) return;
            document.getElementById('editPlayerId').value = p.id;
            document.getElementById('editPlayerName').value = p.name;
            document.getElementById('editPlayerFlag').value = p.flag;
            document.getElementById('editPlayerBirth').value = p.birthDate || '2000-01-01';
            document.getElementById('editPlayerPoints').value = p.points;
            document.getElementById('editPlayerModal').classList.add('open');
        }

        function savePlayerEdit() {
            const id = document.getElementById('editPlayerId').value;
            const p = players.find(x => x.id === id);
            if (p) {
                p.name = document.getElementById('editPlayerName').value.trim() || p.name;
                p.flag = document.getElementById('editPlayerFlag').value.trim() || p.flag;
                p.birthDate = document.getElementById('editPlayerBirth').value;
                savePlayers();
                renderPlayersTable();
                renderRaceTable();
                closeModal('editPlayerModal');
            }
        }

        function openAddPlayerModal() {
            const name = prompt("Имя и Фамилия игрока (латиница):", "Julian Stone");
            if (!name) return;
            const country = prompt("Код страны (например, USA, ITA):", "USA") || "UNK";
            const birth = prompt("Дата рождения (ГГГГ-ММ-ДД):", "1998-05-15") || "1998-05-15";

            players.push({
                id: 'p_' + (players.length + 1),
                rank: players.length + 1,
                name: name,
                flag: country,
                points: 25,
                racePoints: 0,
                birthDate: birth,
                tournamentPoints: {},
                rankChange: 0
            });

            savePlayers();
            renderPlayersTable();
            renderRaceTable();
        }

        // --- 14. ЗАЛ СЛАВЫ ---
        let activeSnapshotKey = 'yearEnd';

        function initHistoryUI() {
            const select = document.getElementById('historyYearSelect');
            const years = Object.keys(seasonsHistory).sort((a, b) => b - a);
            if (years.length === 0) {
                select.innerHTML = '<option value="">Нет завершенных сезонов</option>';
                document.getElementById('historyContent').innerHTML = '<div style="color: var(--text-dim); padding: 30px; text-align: center;">Завершите сезон, чтобы здесь появился архив!</div>';
                return;
            }
            select.innerHTML = years.map(y => `<option value="${y}">Сезон ${y}</option>`).join('');
            renderHistoryYear();
        }

        function setSnapshotKey(key) {
            activeSnapshotKey = key;
            renderHistoryYear();
        }

        function renderHistoryYear() {
            const year = document.getElementById('historyYearSelect').value;
            const data = seasonsHistory[year];
            if (!data) return;

            const slamSnaps = data.slamSnapshots || {};
            const yearEnd50 = data.yearEndTop50 || (data.top10 ? data.top10 : []);

            let activeList = [];
            let activeTitle = "";

            if (activeSnapshotKey === 'yearEnd') {
                activeList = yearEnd50;
                activeTitle = `Итоговый Топ-50 по окончании ${year} года`;
            } else if (slamSnaps[activeSnapshotKey]) {
                activeList = slamSnaps[activeSnapshotKey].top50 || [];
                activeTitle = `Топ-50 после ${slamSnaps[activeSnapshotKey].tourneyName} (${slamSnaps[activeSnapshotKey].date})`;
            }

            let html = `
                <div class="history-card" style="display: flex; justify-content: space-between; align-items: center; border-left: 4px solid var(--gold);">
                    <div>
                        <div style="font-size: 12px; color: var(--gold); font-weight: bold;">👑 ИГРОК ГОДА (WORLD #1) ПО ИТОГАМ ${year}</div>
                        <div style="font-size: 20px; font-weight: bold; margin-top: 4px;">${data.worldNumberOne.flag} ${data.worldNumberOne.name}</div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 12px; color: var(--text-dim);">Итоговые очки:</div>
                        <div style="font-size: 18px; color: var(--accent); font-weight: bold;">${data.worldNumberOne.points.toLocaleString()} pts</div>
                    </div>
                </div>

                <h3 style="margin: 15px 0 8px 0; font-size: 16px;">🏆 Чемпионы турниров в сезоне ${year}</h3>
                <table class="custom-table" style="margin-bottom: 25px;">
                    <thead>
                        <tr>
                            <th>Турнир</th>
                            <th>Покрытие</th>
                            <th>Победитель</th>
                            <th>Финалист</th>
                            <th>Счет финала</th>
                            <th style="width: 140px;">Вся сетка</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${(data.tournamentsData || []).map(t => `
                            <tr>
                                <td><b>${t.name}</b> (${t.type})</td>
                                <td>${t.surface}</td>
                                <td style="color: var(--primary); font-weight: bold;">${t.winner ? t.winner.flag + ' ' + t.winner.name : '—'}</td>
                                <td style="color: var(--text-dim);">${t.runnerUp ? t.runnerUp.flag + ' ' + t.runnerUp.name : '—'}</td>
                                <td class="match-score">${formatTennisScore(t.score.split(' '))}</td>
                                <td>
                                    <button onclick="jumpToTourney('${t.id}', ${year})">🔍 Вся сетка</button>
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>

                <h3 style="margin: 25px 0 6px 0; font-size: 16px;">📊 Срезы Рейтинга Топ-50 за ${year} год (по завершению каждого ТБШ)</h3>
                <small style="color: var(--text-dim); display:block; margin-bottom: 10px;">Выберите срез, чтобы посмотреть положение в Топ-50 на тот момент:</small>

                <div class="snapshot-tabs">
                    <button class="snapshot-btn ${activeSnapshotKey === 'tbsh_1' ? 'active' : ''}" onclick="setSnapshotKey('tbsh_1')">После 1-го ТБШ (Cartom Calamb)</button>
                    <button class="snapshot-btn ${activeSnapshotKey === 'tbsh_2' ? 'active' : ''}" onclick="setSnapshotKey('tbsh_2')">После 2-го ТБШ (Poland Open)</button>
                    <button class="snapshot-btn ${activeSnapshotKey === 'tbsh_3' ? 'active' : ''}" onclick="setSnapshotKey('tbsh_3')">После 3-го ТБШ (Polovchis)</button>
                    <button class="snapshot-btn ${activeSnapshotKey === 'tbsh_4' ? 'active' : ''}" onclick="setSnapshotKey('tbsh_4')">После 4-го ТБШ (Okeanskiy Open)</button>
                    <button class="snapshot-btn ${activeSnapshotKey === 'yearEnd' ? 'active' : ''}" onclick="setSnapshotKey('yearEnd')">Итоговый Топ-50 года 👑</button>
                </div>

                <div style="font-size: 14px; font-weight: bold; color: var(--accent); margin-bottom: 8px;">${activeTitle}</div>

                ${activeList.length === 0 ? `<div style="padding: 20px; color: var(--text-dim); text-align: center; border: 1px dashed var(--border);">Снимок для этой стадии появится автоматически после того, как турнир будет сыгран в сезоне.</div>` : `
                    <div style="max-height: 55vh; overflow-y: auto;">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">Ранг</th>
                                    <th style="width: 70px;">Страна</th>
                                    <th>Игрок</th>
                                    <th style="width: 90px;">Возраст</th>
                                    <th>Очки ATP</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${activeList.map(p => `
                                    <tr>
                                        <td><b>#${p.rank}</b></td>
                                        <td>${p.flag}</td>
                                        <td><b>${p.name}</b></td>
                                        <td style="color: var(--accent);">${p.age || calculateAge(p.birthDate)}</td>
                                        <td><b>${p.points.toLocaleString()}</b> <small style="color:var(--text-dim);">pts</small></td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                `}
            `;

            document.getElementById('historyContent').innerHTML = html;
        }

        function switchTab(tabId) {
            document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));

            if (tabId === 'tourney') {
                document.getElementById('tab-tourney').classList.add('active');
                event.target.classList.add('active');
            } else if (tabId === 'players') {
                document.getElementById('tab-players').classList.add('active');
                event.target.classList.add('active');
                renderPlayersTable();
            } else if (tabId === 'race') {
                document.getElementById('tab-race').classList.add('active');
                event.target.classList.add('active');
                renderRaceTable();
            } else if (tabId === 'calendar') {
                document.getElementById('tab-calendar').classList.add('active');
                event.target.classList.add('active');
                renderCalendarTable();
            } else if (tabId === 'history') {
                document.getElementById('tab-history').classList.add('active');
                event.target.classList.add('active');
                initHistoryUI();
            }
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('open');
            activeMatchScore = null;
        }

        // Запуск системы
        initData();
        initUI();
    </script>
</body>
</html>