        // --- 7. ПОЛНОЦЕННЫЙ H2H АНАЛИЗАТОР И ВВОД СЧЕТА ---
        function getHeadToHeadHistory(p1Id, p2Id) {
            const history = [];
            const years = [2023, 2024, 2025, 2026];

            tournaments.forEach(t => {
                years.forEach(y => {
                    const drawData = JSON.parse(localStorage.getItem(`draw_${t.id}_${y}`));
                    if (drawData && drawData.length > 0) {
                        const rNames = (t.id === 'finals')
                            ? ["Группа А", "Группа Б", "Полуфинал", "Финал"]
                            : (drawData.length === 7 ? rNames128 : (drawData.length === 6 ? rNames64 : rNames32));

                        drawData.forEach((round, rIdx) => {
                            round.forEach(m => {
                                if (m && m.p1 && m.p2 && m.winner) {
                                    const matchFound = (m.p1.id === p1Id && m.p2.id === p2Id) || (m.p1.id === p2Id && m.p2.id === p1Id);
                                    if (matchFound) {
                                        history.push({
                                            year: y,
                                            tourneyName: t.name,
                                            surface: t.surface,
                                            stage: rNames[rIdx] || `Раунд ${rIdx + 1}`,
                                            winnerId: m.winner.id,
                                            winnerName: m.winner.name,
                                            score: m.score ? m.score.join(' ') : 'W/O'
                                        });
                                    }
                                }
                            });
                        });
                    }
                });
            });

            return history;
        }

        function getSurfaceClass(surf) {
            if (surf === 'Хард') return 'surface-hard';
            if (surf === 'Грунт') return 'surface-clay';
            if (surf === 'Трава') return 'surface-grass';
            return 'surface-indoor';
        }

