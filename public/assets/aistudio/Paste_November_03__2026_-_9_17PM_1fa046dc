        // --- 5. ЖЕРЕБЬЕВКА С ВХОДОМ ДЛЯ 50-85 МЕСТ ---
        function generateRealisticDraw() {
            if (currentDraw.length > 0 && !confirm("Сетка уже создана. Пересоздать жеребьевку?")) return;

            const size = activeTourney.size;
            let withdrawals = [];

            if (activeTourney.id === 'finals') {
                const raceSorted = [...players].sort((a, b) => (b.racePoints || 0) - (a.racePoints || 0));
                const top8 = raceSorted.slice(0, 8);

                const p34 = shuffleArray([top8[2], top8[3]]);
                const p56 = shuffleArray([top8[4], top8[5]]);
                const p78 = shuffleArray([top8[6], top8[7]]);

                const groupA = [top8[0], p34[0], p56[0], p78[0]];
                const groupB = [top8[1], p34[1], p56[1], p78[1]];

                const rGroupA = [
                    { p1: groupA[0], p2: groupA[3], score: [], winner: null, group: 'Группа А' },
                    { p1: groupA[1], p2: groupA[2], score: [], winner: null, group: 'Группа А' },
                    { p1: groupA[0], p2: groupA[2], score: [], winner: null, group: 'Группа А' },
                    { p1: groupA[1], p2: groupA[3], score: [], winner: null, group: 'Группа А' },
                    { p1: groupA[0], p2: groupA[1], score: [], winner: null, group: 'Группа А' },
                    { p1: groupA[2], p2: groupA[3], score: [], winner: null, group: 'Группа А' }
                ];

                const rGroupB = [
                    { p1: groupB[0], p2: groupB[3], score: [], winner: null, group: 'Группа Б' },
                    { p1: groupB[1], p2: groupB[2], score: [], winner: null, group: 'Группа Б' },
                    { p1: groupB[0], p2: groupB[2], score: [], winner: null, group: 'Группа Б' },
                    { p1: groupB[1], p2: groupB[3], score: [], winner: null, group: 'Группа Б' },
                    { p1: groupB[0], p2: groupB[1], score: [], winner: null, group: 'Группа Б' },
                    { p1: groupB[2], p2: groupB[3], score: [], winner: null, group: 'Группа Б' }
                ];

                currentDraw = [
                    rGroupA,
                    rGroupB,
                    [
                        { p1: null, p2: null, score: [], winner: null },
                        { p1: null, p2: null, score: [], winner: null }
                    ],
                    [
                        { p1: null, p2: null, score: [], winner: null }
                    ]
                ];

                localStorage.removeItem(`withdrawals_${activeTourney.id}_${viewingYear}`);
                activeTourney.completed = false;
                saveTournaments();
                saveDraw();
                renderRoundTabs();
                renderMatches();
                return;
            }

            let committedPlayers = [];

            if (activeTourney.type === 'ATP 500') {
                players.slice(0, 15).forEach(p => {
                    if (Math.random() < 0.25) committedPlayers.push(p);
                    else withdrawals.push(p.name);
                });
                players.slice(15, 40).forEach(p => {
                    if (Math.random() < 0.35) committedPlayers.push(p);
                    else if (p.rank <= 25) withdrawals.push(p.name);
                });
                players.slice(40, 85).forEach(p => {
                    if (Math.random() < 0.55) committedPlayers.push(p);
                });
                players.slice(85, 140).forEach(p => {
                    if (Math.random() < 0.30) committedPlayers.push(p);
                });

            } else if (activeTourney.type === 'Мастерс') {
                players.slice(0, 20).forEach(p => {
                    if (Math.random() < 0.88) committedPlayers.push(p);
                    else withdrawals.push(p.name);
                });
                players.slice(20, 60).forEach(p => {
                    if (Math.random() < 0.85) committedPlayers.push(p);
                    else if (p.rank <= 30) withdrawals.push(p.name);
                });
                players.slice(60, 95).forEach(p => {
                    if (Math.random() < 0.50) committedPlayers.push(p);
                });

            } else if (activeTourney.type === 'ТБШ') {
                players.slice(0, 105).forEach(p => {
                    if (Math.random() < 0.96) committedPlayers.push(p);
                    else if (p.rank <= 32) withdrawals.push(p.name);
                });
                players.slice(105, 145).forEach(p => {
                    if (Math.random() < 0.60) committedPlayers.push(p);
                });
            }

            committedPlayers.sort((a, b) => a.rank - b.rank);

            localStorage.setItem(`withdrawals_${activeTourney.id}_${viewingYear}`, JSON.stringify(withdrawals.slice(0, 10)));
            const noticeBox = document.getElementById('withdrawalsNotice');
            if (withdrawals.length > 0) {
                noticeBox.style.display = 'block';
                noticeBox.innerHTML = `⚠️ <b>Пропускают турнир (Отдых / Травма / График):</b> ${withdrawals.slice(0, 8).join(', ')}${withdrawals.length > 8 ? ` и еще ${withdrawals.length - 8} игр.` : ''}`;
            } else {
                noticeBox.style.display = 'none';
            }

            let bracket = new Array(size).fill(null);

            // ТБШ (128): СТРОГО СЕЯНЫЕ С (1) ПО (32)
            if (size === 128) {
                const seedsCount = 32;
                const seeds = committedPlayers.slice(0, seedsCount).map((p, idx) => ({ ...p, seedNum: idx + 1 }));

                bracket[0] = seeds[0];
                bracket[127] = seeds[1];
                const s34 = shuffleArray(seeds.slice(2, 4));
                bracket[63] = s34[0];
                bracket[64] = s34[1];

                const slots5_8 = [31, 32, 95, 96];
                const s58 = shuffleArray(seeds.slice(4, 8));
                slots5_8.forEach((pos, idx) => { bracket[pos] = s58[idx]; });

                const slots9_16 = [15, 16, 47, 48, 79, 80, 111, 112];
                const s916 = shuffleArray(seeds.slice(8, 16));
                slots9_16.forEach((pos, idx) => { bracket[pos] = s916[idx]; });

                const slots17_32 = [7, 8, 23, 24, 39, 40, 55, 56, 71, 72, 87, 88, 103, 104, 119, 120];
                const s1732 = shuffleArray(seeds.slice(16, 32));
                slots17_32.forEach((pos, idx) => { bracket[pos] = s1732[idx]; });

                const direct = committedPlayers.slice(32, 96);
                const poolLower = shuffleArray(players.slice(100, 250));
                const qualifiers = poolLower.slice(0, 16).map(p => ({ ...p, entryTag: 'Q' }));
                const wildcards = poolLower.slice(16, 24).map(p => ({ ...p, entryTag: 'WC' }));
                const luckyLosers = poolLower.slice(24, 28).map(p => ({ ...p, entryTag: 'LL' }));
                const protectedRanks = poolLower.slice(28, 32).map(p => ({ ...p, entryTag: 'PR' }));

                let unseeded = shuffleArray([...direct, ...qualifiers, ...wildcards, ...luckyLosers, ...protectedRanks]);
                for (let i = 0; i < 128; i++) {
                    if (!bracket[i]) bracket[i] = unseeded.pop() || poolLower.pop();
                }
                buildStandardRounds(bracket, 128);

            } else if (size === 64) {
                // МАСТЕРС (64): СТРОГО СЕЯНЫЕ С (1) ПО (16)
                const seedsCount = 16;
                const seeds = committedPlayers.slice(0, seedsCount).map((p, idx) => ({ ...p, seedNum: idx + 1 }));

                bracket[0] = seeds[0];
                bracket[63] = seeds[1];
                const s34 = shuffleArray(seeds.slice(2, 4));
                bracket[31] = s34[0];
                bracket[32] = s34[1];

                const slots5_8 = [15, 16, 47, 48];
                const s58 = shuffleArray(seeds.slice(4, 8));
                slots5_8.forEach((pos, idx) => { bracket[pos] = s58[idx]; });

                const slots9_16 = [7, 8, 23, 24, 39, 40, 55, 56];
                const s916 = shuffleArray(seeds.slice(8, 16));
                slots9_16.forEach((pos, idx) => { bracket[pos] = s916[idx]; });

                const direct = committedPlayers.slice(16, 48);
                const poolLower = shuffleArray(players.slice(75, 190));
                const qualifiers = poolLower.slice(0, 8).map(p => ({ ...p, entryTag: 'Q' }));
                const wildcards = poolLower.slice(8, 12).map(p => ({ ...p, entryTag: 'WC' }));
                const luckyLosers = poolLower.slice(12, 14).map(p => ({ ...p, entryTag: 'LL' }));
                const protectedRanks = poolLower.slice(14, 16).map(p => ({ ...p, entryTag: 'PR' }));

                let unseeded = shuffleArray([...direct, ...qualifiers, ...wildcards, ...luckyLosers, ...protectedRanks]);
                for (let i = 0; i < 64; i++) {
                    if (!bracket[i]) bracket[i] = unseeded.pop() || poolLower.pop();
                }
                buildStandardRounds(bracket, 64);

            } else if (size === 32) {
                // ATP 500 (32): СТРОГО СЕЯНЫЕ С (1) ПО (8)
                const seedsCount = 8;
                const seeds = committedPlayers.slice(0, seedsCount).map((p, idx) => ({ ...p, seedNum: idx + 1 }));

                bracket[0] = seeds[0];
                bracket[31] = seeds[1];
                const s34 = shuffleArray(seeds.slice(2, 4));
                bracket[15] = s34[0];
                bracket[16] = s34[1];

                const slots5_8 = [7, 8, 23, 24];
                const s58 = shuffleArray(seeds.slice(4, 8));
                slots5_8.forEach((pos, idx) => { bracket[pos] = s58[idx]; });

                const direct = committedPlayers.slice(8, 24);
                const poolLower = shuffleArray(players.slice(80, 200));
                const qualifiers = poolLower.slice(0, 4).map(p => ({ ...p, entryTag: 'Q' }));
                const wildcards = poolLower.slice(4, 8).map(p => ({ ...p, entryTag: 'WC' }));

                let unseeded = shuffleArray([...direct, ...qualifiers, ...wildcards]);
                for (let i = 0; i < 32; i++) {
                    if (!bracket[i]) bracket[i] = unseeded.pop() || poolLower.pop();
                }
                buildStandardRounds(bracket, 32);
            }

            activeTourney.completed = false;
            saveTournaments();
            saveDraw();
            renderRoundTabs();
            renderMatches();
        }

        function buildStandardRounds(bracket, size) {
            currentDraw = [];
            let r1 = [];
            for (let i = 0; i < size; i += 2) {
                r1.push({ p1: bracket[i], p2: bracket[i + 1], score: [], winner: null });
            }
            currentDraw.push(r1);

            let count = size / 4;
            while (count >= 1) {
                let round = [];
                for (let i = 0; i < count; i++) round.push({ p1: null, p2: null, score: [], winner: null });
                currentDraw.push(round);
                count /= 2;
            }
        }

