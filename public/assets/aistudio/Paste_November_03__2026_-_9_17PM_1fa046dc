        // --- 6. ОТОБРАЖЕНИЕ СЕТОК ---
        const rNames128 = ["1/64 финала", "1/32 финала", "1/16 финала", "1/8 финала", "1/4 финала", "Полуфинал", "ФИНАЛ 🏆"];
        const rNames64 = ["1/32 финала", "1/16 финала", "1/8 финала", "1/4 финала", "Полуфинал", "ФИНАЛ 🏆"];
        const rNames32 = ["1/16 финала", "1/8 финала", "1/4 финала", "Полуфинал", "ФИНАЛ 🏆"];
        const rNamesFinals = ["Группа А (6)", "Группа Б (6)", "Полуфинал (2)", "ФИНАЛ 🏆 (1)"];

