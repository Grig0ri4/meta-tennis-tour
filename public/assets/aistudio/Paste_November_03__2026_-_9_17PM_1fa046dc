        }

        function formatTennisScore(scoreArray) {
            if (!scoreArray || scoreArray.length === 0) return '';
            return scoreArray.map(setStr => setStr.replace(/\((\d+)\)/, '<sup>$1</sup>')).join('  ');
        }

        function calculateGroupStandings(groupMatches) {
            let stats = {};
            groupMatches.forEach(m => {
                if (m.p1 && !stats[m.p1.id]) stats[m.p1.id] = { player: m.p1, wins: 0, losses: 0, setsW: 0, setsL: 0, gamesW: 0, gamesL: 0 };
                if (m.p2 && !stats[m.p2.id]) stats[m.p2.id] = { player: m.p2, wins: 0, losses: 0, setsW: 0, setsL: 0, gamesW: 0, gamesL: 0 };

                if (m.winner && m.score && m.score.length > 0) {
                    const isP1Win = m.winner.id === m.p1.id;
                    const p1 = stats[m.p1.id];
                    const p2 = stats[m.p2.id];

                    if (isP1Win) { p1.wins++; p2.losses++; }
                    else { p2.wins++; p1.losses++; }

                    m.score.forEach(s => {
                        const clean = s.replace(/\(\d+\)/, '');
                        const parts = clean.split('-');
                        if (parts.length === 2) {
                            const g1 = parseInt(parts[0]);
                            const g2 = parseInt(parts[1]);
                            p1.gamesW += g1; p1.gamesL += g2;
                            p2.gamesW += g2; p2.gamesL += g1;
                            if (g1 > g2) { p1.setsW++; p2.setsL++; }
                            else { p2.setsW++; p1.setsL++; }
                        }
                    });
                }
            });

            return Object.values(stats).sort((a, b) => {
                if (b.wins !== a.wins) return b.wins - a.wins;
                const setDiffB = b.setsW - b.setsL;
                const setDiffA = a.setsW - a.setsL;
                if (setDiffB !== setDiffA) return setDiffB - setDiffA;
                return (b.gamesW - b.gamesL) - (a.gamesW - a.gamesL);
            });
        }

        function renderMatches() {
            const container = document.getElementById('matchesContainer');
            const tablesContainer = document.getElementById('finalsGroupTablesContainer');
            container.innerHTML = '';

            if (!currentDraw || currentDraw.length === 0) {
                tablesContainer.style.display = 'none';
