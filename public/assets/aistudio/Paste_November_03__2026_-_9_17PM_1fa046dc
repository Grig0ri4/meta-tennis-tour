            return `${day} ${months[d.getMonth()]} ${d.getFullYear()}`;
        }

        function getTourneyDateRange(t, year) {
            const startD = new Date(year, t.startMonth, t.startDay);
            const endD = new Date(year, t.endMonth, t.endDay);
            const pad = (n) => String(n).padStart(2, '0');
            return `${pad(startD.getDate())}.${pad(startD.getMonth() + 1)} - ${pad(endD.getDate())}.${pad(endD.getMonth() + 1)}.${year}`;
        }

